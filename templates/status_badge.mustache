{{!
    @template local_ai_coursecreator/status_badge

    Status badge shown in a course-generation progress row.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * pending - boolean, show the idle spinner-grow badge (no text)
    * running - boolean, show the running spinner-border badge with status text
    * done    - boolean, show the success "Done" badge

    Example context (json):
    {
        "running": true
    }
}}
{{#pending}}
<span class="spinner-grow spinner-grow-sm text-secondary" role="status"></span>
{{/pending}}
{{#running}}
<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>{{#str}} status_running, local_ai_coursecreator {{/str}}
{{/running}}
{{#done}}
<span class="badge bg-success">{{#str}} status_done, local_ai_coursecreator {{/str}}</span>
{{/done}}
