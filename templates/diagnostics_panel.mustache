{{!
    @template local_ai_coursecreator/diagnostics_panel

    Diagnostics panel button + output area for the "Test API Connection" admin setting.
    JS behaviour is wired up separately via local_ai_coursecreator/diagnostics (js_call_amd).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none - all text comes from {{#str}} tags.

    Example context (json):
    {}
}}
<div class="mt-2">
    <p class="text-muted small mb-2">{{#str}} diag_test_desc, local_ai_coursecreator {{/str}}</p>
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <button id="aicc-conn-btn" type="button" class="btn btn-sm btn-outline-secondary">{{#str}} diag_test_btn, local_ai_coursecreator {{/str}}</button>
    </div>
    <pre id="aicc-diag-out" class="bg-light border rounded p-2 small mb-0"
         style="min-height:3em;white-space:pre-wrap;word-break:break-all">{{#str}} diag_results_placeholder, local_ai_coursecreator {{/str}}</pre>
</div>
